{
  "contract": "ws_media",
  "version": "2.0",
  "doc": "Away call audio: a claimed phone carries a call's audio as frames on its HA websocket (design: automation/portico_away_media_design.md, estate repo). Each case starts from one door (door_id 127.0.0.1) with one enrolled phone and a call 'c1' that is ringing. A step is either a client message with the frames HA sends back, in order, or a transport notification. Off by default: 'flag' is the door entry's away_media option. d is base64 of one 40 ms frame: 320 bytes for pcmu (8 kHz mu-law), 1280 for l16 (16 kHz little-endian PCM). Uplink portico/media_frame is never answered on success. Contract 3 (portico-ha M6 E3): the commands name the door by `door_id` (v1: `device_id`) and an unknown door is `unknown_door` (v1: `unknown_device`). The frames are otherwise unchanged from ws_media_v1.json.",
  "cases": [
    {
      "name": "flag off: refused, nothing opened",
      "flag": false,
      "steps": [
        {
          "send": {
            "id": 1,
            "type": "portico/answer",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "client_kind": "browser"
          },
          "recv": [
            {
              "id": 1,
              "type": "result",
              "success": true,
              "result": {
                "mode": "relay"
              }
            }
          ]
        },
        {
          "send": {
            "id": 2,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 2,
              "type": "result",
              "success": false,
              "error": {
                "code": "away_media_disabled",
                "message": "call audio over the websocket is not enabled"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "open, downlink frame, uplink frame, phone closes",
      "flag": true,
      "steps": [
        {
          "send": {
            "id": 1,
            "type": "portico/answer",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "client_kind": "browser"
          },
          "recv": [
            {
              "id": 1,
              "type": "result",
              "success": true,
              "result": {
                "mode": "relay"
              }
            }
          ]
        },
        {
          "send": {
            "id": 2,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 2,
              "type": "result",
              "success": true,
              "result": {
                "codec": "pcmu",
                "frame_bytes": 320,
                "frame_ms": 40
              }
            }
          ]
        },
        {
          "notify": {
            "method": "media_frame",
            "params": {
              "call_id": "c1",
              "d": "QUJD"
            }
          },
          "recv": [
            {
              "id": 2,
              "type": "event",
              "event": {
                "t": "f",
                "d": "QUJD"
              }
            }
          ]
        },
        {
          "send": {
            "id": 3,
            "type": "portico/media_frame",
            "call_id": "c1",
            "d": "REVG"
          },
          "recv": []
        },
        {
          "send": {
            "id": 4,
            "type": "portico/media_close",
            "call_id": "c1"
          },
          "recv": [
            {
              "id": 2,
              "type": "event",
              "event": {
                "t": "end",
                "reason": "closed_by_phone"
              }
            },
            {
              "id": 4,
              "type": "result",
              "success": true,
              "result": {
                "ok": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "l16: open, 1280-byte downlink frame, 1280-byte uplink frame, phone closes",
      "flag": true,
      "steps": [
        {
          "send": {
            "id": 1,
            "type": "portico/answer",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "client_kind": "browser"
          },
          "recv": [
            {
              "id": 1,
              "type": "result",
              "success": true,
              "result": {
                "mode": "relay"
              }
            }
          ]
        },
        {
          "send": {
            "id": 2,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "l16"
          },
          "recv": [
            {
              "id": 2,
              "type": "result",
              "success": true,
              "result": {
                "codec": "l16",
                "frame_bytes": 1280,
                "frame_ms": 40
              }
            }
          ]
        },
        {
          "notify": {
            "method": "media_frame",
            "params": {
              "call_id": "c1",
              "d": ""
            }
          },
          "recv": [
            {
              "id": 2,
              "type": "event",
              "event": {
                "t": "f",
                "d": ""
              }
            }
          ]
        },
        {
          "send": {
            "id": 3,
            "type": "portico/media_frame",
            "call_id": "c1",
            "d": ""
          },
          "recv": []
        },
        {
          "send": {
            "id": 4,
            "type": "portico/media_close",
            "call_id": "c1"
          },
          "recv": [
            {
              "id": 2,
              "type": "event",
              "event": {
                "t": "end",
                "reason": "closed_by_phone"
              }
            },
            {
              "id": 4,
              "type": "result",
              "success": true,
              "result": {
                "ok": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "the transport reports the leg gone (no uplink for 5 s)",
      "flag": true,
      "steps": [
        {
          "send": {
            "id": 1,
            "type": "portico/answer",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "client_kind": "browser"
          },
          "recv": [
            {
              "id": 1,
              "type": "result",
              "success": true,
              "result": {
                "mode": "relay"
              }
            }
          ]
        },
        {
          "send": {
            "id": 2,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 2,
              "type": "result",
              "success": true,
              "result": {
                "codec": "pcmu",
                "frame_bytes": 320,
                "frame_ms": 40
              }
            }
          ]
        },
        {
          "notify": {
            "method": "media_closed",
            "params": {
              "call_id": "c1",
              "reason": "idle"
            }
          },
          "recv": [
            {
              "id": 2,
              "type": "event",
              "event": {
                "t": "end",
                "reason": "idle"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "refusals: unclaimed call, unknown device, second open",
      "flag": true,
      "steps": [
        {
          "send": {
            "id": 1,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 1,
              "type": "result",
              "success": false,
              "error": {
                "code": "unknown_call",
                "message": "c1"
              }
            }
          ]
        },
        {
          "send": {
            "id": 2,
            "type": "portico/media_open",
            "door_id": "nope",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 2,
              "type": "result",
              "success": false,
              "error": {
                "code": "unknown_door",
                "message": "nope"
              }
            }
          ]
        },
        {
          "send": {
            "id": 3,
            "type": "portico/answer",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "client_kind": "browser"
          },
          "recv": [
            {
              "id": 3,
              "type": "result",
              "success": true,
              "result": {
                "mode": "relay"
              }
            }
          ]
        },
        {
          "send": {
            "id": 4,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 4,
              "type": "result",
              "success": true,
              "result": {
                "codec": "pcmu",
                "frame_bytes": 320,
                "frame_ms": 40
              }
            }
          ]
        },
        {
          "send": {
            "id": 5,
            "type": "portico/media_open",
            "door_id": "127.0.0.1",
            "call_id": "c1",
            "codec": "pcmu"
          },
          "recv": [
            {
              "id": 5,
              "type": "result",
              "success": false,
              "error": {
                "code": "already_open",
                "message": "c1"
              }
            }
          ]
        }
      ]
    }
  ]
}
